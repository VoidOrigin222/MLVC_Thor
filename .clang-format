BasedOnStyle: Google
Language: Cpp
Standard: c++17
IndentWidth: 2
ColumnLimit: 80
PointerAlignment: Left
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[^/]+\.h>$'
    Priority: 1
  - Regex: '^<(sys|linux)/'
    Priority: 1
  - Regex: '^<[^/.]+>$'
    Priority: 2
  - Regex: '.*'
    Priority: 3
